# Виртуальное окружение
venv/
env/

# Секреты
.env

# База данных SQLite (если используется локально)
db.sqlite3

# Кэш Python и прочее
__pycache__/
*.py[cod]
*$py.class
*.log

# Медиа и статика (загруженные пользователями файлы не пушим)
media/
staticfiles/
# Видео уроков — лежат вне MEDIA_ROOT и в репозиторий не попадают
protected_media/

# Настройки PyCharm
.idea/