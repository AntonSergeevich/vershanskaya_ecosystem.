# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Базовое ---------------------------------------------------------------
DEBUG=True
SECRET_KEY=сгенерируйте-python-c-"import secrets;print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=localhost,127.0.0.1
# Для прода: CSRF_TRUSTED_ORIGINS=https://vershanskaya.ru

# --- PostgreSQL (если переменные не заданы — используется локальный SQLite) --
# POSTGRES_DB=vershanskaya
# POSTGRES_USER=vershanskaya
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Экосистема ------------------------------------------------------------
CLUB_PRICE=2900
TELEGRAM_CHANNEL_URL=https://t.me/ekaterinavershanskaya
INSTAGRAM_URL=https://www.instagram.com/ekaterina_arhetypes/

# --- Telegram-бот (1-click вход + инвайты в закрытый чат) -------------------
# Пока токен пуст — уведомления и инвайты только пишутся в лог.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=vershanskaya_bot
# Чат клуба (бот должен быть админом с правом приглашать)
# TELEGRAM_CLUB_CHAT_ID=-1001234567890
# Личный чат эксперта — туда падают новые лиды и оплаты
# TELEGRAM_ADMIN_CHAT_ID=

# --- Защищённые видео ------------------------------------------------------
# Видео уроков лежат вне MEDIA_ROOT и отдаются только после проверки доступа.
# PROTECTED_MEDIA_ROOT=/srv/vershanskaya/protected_media
# В проде отдачу файла лучше поручить nginx (internal location):
# PROTECTED_MEDIA_USE_NGINX=False
# PROTECTED_MEDIA_NGINX_LOCATION=/protected-media/

# --- Эквайринг -------------------------------------------------------------
# PAYMENT_PROVIDER=yookassa   # yookassa | prodamus
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# PRODAMUS_FORM_URL=
